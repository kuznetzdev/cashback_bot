BOT_TOKEN=123456:replace_me
TELEGRAM_BOT_USERNAME=your_bot_username
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=cashback_bot
POSTGRES_USER=cashback_user
POSTGRES_PASSWORD=cashback_password
POSTGRES_ADMIN_DB=postgres
DATABASE_URL=
TESSERACT_PATH=tesseract
LANG_DEFAULT=ru
OCR_TIMEOUT=20
MAX_FILE_SIZE=5242880
# OCR_PROVIDER: auto (OpenAI vision if OPENAI_API_KEY set, else tesseract) | openai | tesseract
OCR_PROVIDER=auto
OPENAI_API_KEY=
# Leave OPENAI_BASE_URL empty for the real OpenAI. Override for proxies
# (ProxyAPI, VSEgpt), self-hosted Ollama/LM Studio, Together/Groq, etc.
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o
OPENAI_VISION_TIMEOUT=60
OPENAI_VISION_MAX_TOKENS=1024
APP_TIMEZONE=Europe/Moscow
REMINDER_HOUR=10
DB_CONNECT_MAX_ATTEMPTS=20
DB_CONNECT_RETRY_DELAY=2.0
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=300
TELEGRAM_RETRY_DELAY=5.0
AUTO_CREATE_DB=true
AUTO_MIGRATE=true
MIGRATION_MAX_ATTEMPTS=10
MIGRATION_RETRY_DELAY=2.0
APP_ENABLE_TELEGRAM=true
APP_ENABLE_WEB=false
WEB_HOST=0.0.0.0
WEB_PORT=8080
WEB_BASE_URL=http://localhost:8080
WEB_SESSION_SECRET=change-me-session-secret
WEB_SECURE_COOKIES=false
WEB_MAX_UPLOAD_SIZE=5242880
LOG_LEVEL=INFO
TEMP_DIR=ocr_tmp
# FSM storage — `memory` loses state on restart, `redis` persists. Use `redis`
# in production so users don't lose their wizard progress on deploys/OOM kills.
FSM_STORAGE=memory
# Redis connection URL. Required when FSM_STORAGE=redis. Example:
#   REDIS_URL=redis://redis:6379/0
REDIS_URL=
# Webhook mode for Telegram Bot API (recommended for production with a public
# HTTPS endpoint). Leave disabled to use polling.
WEBHOOK_ENABLED=false
WEBHOOK_PATH=/bot/webhook
# Secret token used to verify X-Telegram-Bot-Api-Secret-Token header. Generate
# a random string (~32 chars). Empty disables header verification.
WEBHOOK_SECRET=
# Web API CORS. Comma-separated origins or `*` for any origin.
CORS_ORIGINS=*
# Token required to scrape /metrics (Authorization: Bearer <token>). Empty
# disables /metrics entirely in production deployments.
METRICS_TOKEN=
# Public API rate limit per IP per minute (GET /api/best, etc.).
API_RATE_LIMIT_PER_MINUTE=60
# Reminder cadence — pre-month nudge fires when this-many days are left
# in the current month (3 = "weekend before the rollover").
PRE_MONTH_REMINDER_WINDOW_DAYS=3
# Stale-data nudge fires when the user hasn't refreshed their banks /
# items for this many days (14 = roughly half a Russian-bank cashback
# rotation cycle).
STALE_DATA_THRESHOLD_DAYS=14
